[submodule "src/zed-ros2-examples"]
	path = src/zed-ros2-examples
	url = https://github.com/stereolabs/zed-ros2-examples.git
[submodule "src/zed-ros2-wrapper"]
	path = src/zed-ros2-wrapper
	url = git@github.com:AutonomousDrivingH2politO/zed-ros2-wrapper.git
	branch = autonmous-driving
[submodule "src/rtabmap_ros"]
  path = src/rtabmap_ros
  url = git@github.com:AutonomousDrivingH2politO/rtabmap_ros.git
  branch = autonomous-driving
[submodule "src/ublox"]
	path = src/ublox
	url = git@github.com:AutonomousDrivingH2politO/ublox.git
  branch = ros2
[submodule "src/ntrip_client"]
	path = src/ntrip_client
	url = git@github.com:AutonomousDrivingH2politO/ntrip_client.git
  branch = ros2
[submodule "src/shared_objects/src/shared_objects/TwinLiteNetPlus"]
	path = src/shared_objects/src/shared_objects/TwinLiteNetPlus
	url = git@github.com:chequanghuy/TwinLiteNetPlus.git
[submodule "src/async_port"]
	path = src/async_port
	url = https://github.com/westonrobot/async_port.git
[submodule "src/scout_ros2"]
	path = src/scout_ros2
	url = git@github.com:AutonomousDrivingH2politO/scout_ros2.git
[submodule "src/ugv_sdk"]
	path = src/ugv_sdk
	url = https://github.com/agilexrobotics/ugv_sdk.git
